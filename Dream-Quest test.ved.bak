				<text Text="fridge" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="735" order="735" lastModified="-1">
			<TextTextLanguages>
				<text Text="the place in front which i contemplate about my life's choices" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="736" order="736" lastModified="-1">
			<TextTextLanguages>
				<text Text="thankfully i can keep it full now in days" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="737" order="737" lastModified="-1">
			<TextTextLanguages>
				<text Text="but few years ago it was often like a white, cold abyss" path="" int="1"/>
			</TextTextLanguages>
		</Text>
