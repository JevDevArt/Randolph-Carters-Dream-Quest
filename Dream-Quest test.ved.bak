			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="706" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="hello there little guy!" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="707" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="it's,, my chldhood plushie, he's been with me through the worst" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="708" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="he needed lots of stiches to still be here, but thankfully, i managed to fix him up" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="709" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="nah, i prefer to not disturb him. especially when not needed" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="710" order="710" lastModified="-1">
			<TextTextLanguages>
				<text Text="pentagram?" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="711" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="see, um, I prefer to be better safe than sorry" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="712" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="yeah, some extra protecton from the occult won't hurt." path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="713" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="and considering with what forces im about to come in contact with? " path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="714" order="714" lastModified="-1">
			<TextTextLanguages>
				<text Text="plant" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="715" order="715" lastModified="-1">
			<TextTextLanguages>
				<text Text="not sure what plant exactly this is, but it grew so fast!" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="716" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="i hope it wont swallow the entire room soon, hah" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="717" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="..." path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="718" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="i know this one's pretty on the nose out in the world but-" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="719" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="i kinda gave up on where to put it" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="720" order="720" lastModified="-1">
			<TextTextLanguages>
				<text Text="sink" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="721" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="suprisingly, i left it clean this time" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="722" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="...we'll see how long that lasts" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="723" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="suprisingly, i left it clean this time" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="724" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="...we'll see how long that lasts" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="725" order="725" lastModified="-1">
			<TextTextLanguages>
				<text Text="cups" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="726" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="ah, noo, I forgot abot my tea" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="727" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="it's cold now" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="732" order="706" lastModified="-1">
			<TextTextLanguages>
				<text Text="ah, noo, I forgot abot my tea" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="733" order="706" lastModified="-1">
			<TextTextLanguages>
