	<Scripts newId="2" versionedId="-1" tableId="30">
		<Script name="sliding_puzzle1" id="1" order="0" lastModified="-1" ScriptScript="--[[&lt;br/&gt;Sliding Puzzle (3x3) [v4] (28/04/2022)&lt;br/&gt;Written by AFRLme [Lee Clarke]&lt;br/&gt;-- + --&lt;br/&gt;afrlme@outlook.com | https://afrl.me&lt;br/&gt;-- + --&lt;br/&gt;This script is donation optional. In game credit is non-negotiable.&lt;br/&gt;You are free to: ¹ use it in your game(s). ² modify the script.&lt;br/&gt;Do not remove - or edit - this comment block.&lt;br/&gt;--]]&lt;br/&gt;&lt;br/&gt;-- * tables * --&lt;br/&gt;local t = {} -- init local table for storing tile coordinates, names, &amp; move positions&lt;br/&gt;&lt;br/&gt;-- * function for initializing tiles * --&lt;br/&gt;function initPuzzle()&lt;br/&gt; Values[&quot;move_count&quot;].Int = 0&lt;br/&gt; -- + initialize the grid properties + --&lt;br/&gt; t[1] = { x = 455, y = 27, name = nil, move = {2,4} }&lt;br/&gt; t[2] = { x = 810, y = 27, name = &quot;anim_p1&quot;, move = {1,3,5} }&lt;br/&gt; t[3] = { x = 1160, y = 27, name = &quot;anim_p3&quot;, move = {2,6} }&lt;br/&gt; t[4] = { x = 455, y = 370, name = &quot;anim_p4&quot;, move = {1,5,7} }&lt;br/&gt; t[5] = { x = 810, y = 370, name = &quot;anim_p2&quot;, move = {2,4,6,8} }&lt;br/&gt; t[6] = { x = 1160, y = 370, name = &quot;anim_p5&quot;, move = {3,5,9} }&lt;br/&gt; t[7] = { x = 455, y = 720, name = &quot;anim_p7&quot;, move = {4,8} }&lt;br/&gt; t[8] = { x = 810, y = 720, name = &quot;anim_p8&quot;, move = {5,7,9} }&lt;br/&gt; t[9] = { x = 1160, y = 720, name = &quot;anim_p6&quot;, move = {6,8} }&lt;br/&gt; -- + move tiles to correct position if in wrong position + --&lt;br/&gt; for i = 2, 9 do ActiveAnimations[ t[i].name ]:to(0, { CurrentPosition = { x = t[i].x, y = t[i].y } }) end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;-- * function used to determine if player wins * --&lt;br/&gt;function puzzleState(v)&lt;br/&gt; for i = 1, 8 do&lt;br/&gt;  if t[i].name == &quot;anim_p&quot;..i then v = v + 1 end&lt;br/&gt;  if i == 8 and v == 8 then startAction( game.CurrentScene.Actions[&quot;puzzle_solved&quot;] ) end&lt;br/&gt; end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;-- * function for updating tile positions * --&lt;br/&gt;function canMove(v)&lt;br/&gt;  for i = 1, #t[v][&quot;move&quot;] do&lt;br/&gt;   if t[ t[v][&quot;move&quot;][i] ].name == nil and not Conditions[&quot;puzzle_solved&quot;].Value then moveTile(v, t[v][&quot;move&quot;][i], 200, easeLinearOut); Values[&quot;move_count&quot;].Int = Values[&quot;move_count&quot;].Int + 1; break end&lt;br/&gt;  end&lt;br/&gt;end&lt;br/&gt;&lt;br/&gt;-- * function that is used to move the animation from one position to another with delay &amp; easing * --&lt;br/&gt;function moveTile(a, b, delay, easing)&lt;br/&gt; ActiveAnimations[ t[a].name ]:to(delay, { CurrentPosition = {x = t[b].x, y = t[b].y} }, easing)&lt;br/&gt; t[b].name = t[a].name; t[a].name = nil; puzzleState(0) -- update tile position names &amp; check puzzle state&lt;br/&gt;end" ScriptType="1">
		</Script>
	</Scripts>
