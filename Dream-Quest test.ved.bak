			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="607" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="Bow before the gates of the Bloody Tongue! Surrender your offerings, or forsake your pursuit!&lt;br/&gt;" path="sound/sfx/nyarl/entry.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="608" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="Oh you poor fool… I’m afraid this simply won’t do! " path="sound/sfx/nyarl/wrong item 1.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="609" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="How dare you disgrace the mighty gods with such useless junk? &lt;br/&gt;You truly not know what ya messed with you mere mortal!" path="sound/sfx/nyarl/wrong item 2.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="610" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="Well well then. Your Quest comes to an end then! wake up.&lt;br/&gt;" path="sound/sfx/nyarl/no item.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="612" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="You’re an absolute fool." path="sound/sfx/nyarl/silv key.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="613" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="Oh you poor fool… I’m afraid this simply won’t do! " path="sound/sfx/nyarl/wrong item 1.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="615" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="How dare you disgrace the mighty gods with such useless junk? &lt;br/&gt;You truly not know what ya messed with you mere mortal!" path="sound/sfx/nyarl/wrong item 2.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="616" order="607" lastModified="-1">
