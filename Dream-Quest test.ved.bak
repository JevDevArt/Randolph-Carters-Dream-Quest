		</Text>
		<Text name="Unnamed" id="620" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="good one Carter. good luck. dont die~" path="sound/sfx/nyarl/earring2.opus" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="622" order="607" lastModified="-1">
			<TextTextLanguages>
				<text Text="HOW DID YOU EVEN– ahem. I mean. The offering will do. You may proceed. &lt;br/&gt;Though how you got it is perplexing to the gods. " path="sound/sfx/nyarl/earring1.opus" int="1"/>
			</TextTextLanguages>
