		</Text>
		<Text name="Unnamed" id="663" order="655" lastModified="-1">
			<TextTextLanguages>
				<text Text="maybe excluing some shady historical institutes but. these are rather hit or miss" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="664" order="655" lastModified="-1">
			<TextTextLanguages>
				<text Text="too many memories to dig through right now if i have to be honest" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="665" order="655" lastModified="-1">
			<TextTextLanguages>
				<text Text="i found it near the graveyard some time ago" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="666" order="655" lastModified="-1">
			<TextTextLanguages>
				<text Text="it seems vaugely egiptan, but it's very weird" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="667" order="655" lastModified="-1">
			<TextTextLanguages>
				<text Text="it has two clasps for some reason? and has some weight to it" path="" int="1"/>
			</TextTextLanguages>
		</Text>
		<Text name="Unnamed" id="668" order="655" lastModified="-1">
			<TextTextLanguages>
